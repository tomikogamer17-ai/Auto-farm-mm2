-- FONCTION SERVEUR HOP AVEC NOTIFICATION
--------------------------------------------------------------------------------
local function serverHop(raison)
    local reasonText = raison or "Changement manuel"
    createNotification(reasonText)
    print("[Server Hop] " .. reasonText)

    local ApiUrl = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    local success, result = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(ApiUrl))
    end)
    
    if success and result and result.data then
        local validServers = {}
        for _, s in ipairs(result.data) do
            if type(s) == "table" and s.id ~= game.JobId and s.playing < s.maxPlayers and s.playing > 1 then
                table.insert(validServers, s.id)
            end
        end
        
        if #validServers > 0 then
            local randomServerId = validServers[math.random(1, #validServers)]
            TeleportService:TeleportToPlaceInstance(game.PlaceId, randomServerId, player)
        else
            TeleportService:Teleport(game.PlaceId, player)
        end
    else
        TeleportService:Teleport(game.PlaceId, player)
    end
end

