local function checkInventory(targetPlayer)
    local targetChar = targetPlayer.Character
    local backpack = targetPlayer:FindFirstChild("Backpack")

    if targetChar then
        for _, item in ipairs(targetChar:GetChildren()) do
            if item:IsA("Tool") then
                for keyword, role in pairs(WEAPONS) do
                    if item.Name:lower():find(keyword:lower()) then return role end
                end
            end
        end
    end

    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") then
                for keyword, role in pairs(WEAPONS) do
                    if item.Name:lower():find(keyword:lower()) then return role end
                end
            end
        end
    end
    return nil
end

local function isPlayerMurderer(targetPlayer)
    if playerRoles[targetPlayer.Name] == "Murderer" then
        return true
    end
    if checkInventory(targetPlayer) == "Murderer" then
        return true
    end
    return false
end

local function findMurderer()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            if isPlayerMurderer(p) then
                return p
            end
        end
    end
    return nil
end

local function executeMurdererFling()
    local murderer = findMurderer()
    if murderer then
        FlingActive = true
        selectedPlayer = murderer.Name
        SkidFling(murderer)
        FlingActive = false
        selectedPlayer = nil
    end
end

