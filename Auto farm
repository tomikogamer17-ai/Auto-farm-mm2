-- FONCTION SERVEUR HOP
--------------------------------------------------------------------------------
local function serverHop(raison)
    local reasonText = raison or "Changement de serveur manuel"
    print("=========================================")
    print("[Server Hop] Raison: " .. reasonText)
    print("=========================================")
    
    if ReasonLabel then
        ReasonLabel.Text = "Server Hop: " .. reasonText
    end

    local ApiUrl = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Desc&limit=100"
    local success, result = pcall(function()
        return HttpService:JSONDecode(game:HttpGet(ApiUrl))
    end)
    
    if success and result and result.data then
        local validServers = {}
        for _, s in ipairs(result.data) do
            if type(s) == "table" and s.id ~= game.JobId and s.playing < (s.maxPlayers or 12) and s.playing > 1 then
                table.insert(validServers, s.id)
            end
        end
        
        if #validServers > 0 then
            local randomServerId = validServers[math.random(1, #validServers)]
            TeleportService:TeleportToPlaceInstance(game.PlaceId, randomServerId, player)
        else
            TeleportService:Teleport(game.PlaceId, player)
        end
    else
        TeleportService:Teleport(game.PlaceId, player)
    end
end

