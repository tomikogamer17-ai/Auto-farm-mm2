local function applyHighlight(targetPlayer, role)
    local targetChar = targetPlayer.Character
    if not targetChar or not isPlayerESPActive then
        if targetChar and targetChar:FindFirstChild("RoleESP") then
            targetChar.RoleESP:Destroy()
        end
        return
    end

    local color = COLORS[role] or COLORS.Innocent
    local h = targetChar:FindFirstChild("RoleESP") or Instance.new("Highlight")
    h.Name = "RoleESP"
    h.Parent = targetChar
    h.FillColor = color
    h.FillTransparency = 0.35
    h.OutlineColor = color
    h.OutlineTransparency = 0
    h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    h.Enabled = true
end

local function checkInventory(targetPlayer)
    if targetPlayer == player then return nil end
    local targetChar = targetPlayer.Character
    local backpack = targetPlayer:FindFirstChild("Backpack")

    if targetChar then
        for _, item in ipairs(targetChar:GetChildren()) do
            if item:IsA("Tool") then
                for keyword, role in pairs(WEAPONS) do
                    if item.Name:lower():find(keyword:lower()) then return role end
                end
            end
        end
    end

    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") then
                for keyword, role in pairs(WEAPONS) do
                    if item.Name:lower():find(keyword:lower()) then return role end
                end
            end
        end
    end
    return nil
end

local function getMyRole()
    return playerRoles[player.Name] or checkInventory(player) or "Innocent"
end

local function findMurderer()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local role = playerRoles[p.Name] or checkInventory(p)
            if role == "Murderer" then
                return p
            end
        end
    end
    return nil
end

task.spawn(function()
    while true do
        if isPlayerESPActive then
            for _, p in ipairs(Players:GetPlayers()) do
                if p.Character and p.Character:FindFirstChild("HumanoidRootPart") and p ~= player then
                    local roleToAssign = playerRoles[p.Name] or checkInventory(p) or "Innocent"
                    applyHighlight(p, roleToAssign)
                end
            end
        end
        task.wait(0.25)
    end
end)

local gameplayFolder = ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("Gameplay")
if gameplayFolder then
    local showRoleSelectNew = gameplayFolder:FindFirstChild("ShowRoleSelectNew")
    if showRoleSelectNew and showRoleSelectNew:IsA("RemoteEvent") then
        showRoleSelectNew.OnClientEvent:Connect(function(data)
            if type(data) == "table" and data.SelectedRole then
                playerRoles[player.Name] = data.SelectedRole
                applyHighlight(player, data.SelectedRole)
            end
        end)
    end

    local coinCollectedRemote = gameplayFolder:FindFirstChild("CoinCollected")
    if coinCollectedRemote and coinCollectedRemote:IsA("RemoteEvent") then
        coinCollectedRemote.OnClientEvent:Connect(function(coinType, currentCoins, maxCoins)
            if currentCoins >= maxCoins or currentCoins >= 50 then
                local myRole = getMyRole()

                if myRole == "Murderer" then
                    if character and character:FindFirstChildOfClass("Humanoid") then
                        character:BreakJoints()
                    end
                else
                    isAutoFarmActive = false
                    if humanoid then humanoid.PlatformStand = false end
                    if rootPart then rootPart.AssemblyLinearVelocity = Vector3.zero end

                    if rootPart then
                        rootPart.CFrame = CFrame.new(513, 461, 37)
                        task.wait(0.2)
                    end

                    local murderer = findMurderer()
                    if murderer then
                        FlingActive = true
                        selectedPlayer = murderer.Name
                        SkidFling(murderer)
                        FlingActive = false
                        selectedPlayer = nil
                    end

                    if farmToggleState then
                        isAutoFarmActive = true
                    end
                end
            end
        end)
    end
end

