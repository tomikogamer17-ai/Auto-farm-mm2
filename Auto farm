local espEnabled = false
local espObjects = {}

local function addCoinESP(obj)
    if not espEnabled then return end
    if not obj:IsA("BasePart") then return end
    if obj.Name:lower() ~= "coin_server" then return end
    if espObjects[obj] then return end

    local box = Instance.new("BoxHandleAdornment")
    box.Name = "CoinESP_Box"
    box.Adornee = obj
    box.Size = obj.Size + Vector3.new(0.15, 0.15, 0.15)
    box.Color3 = Color3.fromRGB(255, 220, 0)
    box.Transparency = 0
    box.AlwaysOnTop = true
    box.ZIndex = 10
    box.Visible = true
    box.Parent = obj

    espObjects[obj] = box
end

local function removeCoinESP()
    for obj, box in pairs(espObjects) do
        if box and box.Parent then
            box:Destroy()
        end
        espObjects[obj] = nil
    end
end

