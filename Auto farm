local function blacklisterCoin(coinObj)
    if coinObj and not coinsBlacklist[coinObj] then
        coinsBlacklist[coinObj] = true
        if currentTarget and currentTarget.Object == coinObj then
            currentTarget = nil
        end
        local targetPart = getCoinPart(coinObj)
        if targetPart then
            local box = targetPart:FindFirstChild("CandyESP_Box")
            local hl = targetPart:FindFirstChild("CandyESP_HL")
            if box then box:Destroy() end
            if hl then hl:Destroy() end
        end
    end
end

Workspace.DescendantRemoving:Connect(function(obj)
    if string.lower(obj.Name) == "coin_server" then
        coinsBlacklist[obj] = true
    end
end)

local function appliquerCoinESP(obj)
    if string.lower(obj.Name) == "coin_server" and not coinsBlacklist[obj] then
        local targetPart = getCoinPart(obj)
        if targetPart and isCoinESPActive then
            if not targetPart:FindFirstChild("CandyESP_Box") then
                local box = Instance.new("SelectionBox")
                box.Name = "CandyESP_Box"
                box.Color3 = Color3.fromRGB(255, 215, 0)
                box.LineThickness = 0.08
                box.Adornee = targetPart
                box.Parent = targetPart
            end
            if not targetPart:FindFirstChild("CandyESP_HL") then
                local hl = Instance.new("Highlight")
                hl.Name = "CandyESP_HL"
                hl.Adornee = targetPart
                hl.FillColor = Color3.fromRGB(255, 215, 0)
                hl.FillTransparency = 0.4
                hl.OutlineColor = Color3.fromRGB(255, 255, 0)
                hl.OutlineTransparency = 0
                hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                hl.Parent = targetPart
            end
        end
    end
end

task.spawn(function()
    while task.wait(0.5) do
        if isCoinESPActive then
            for _, obj in ipairs(Workspace:GetDescendants()) do
                if string.lower(obj.Name) == "coin_server" then
                    appliquerCoinESP(obj)
                end
            end
        end
    end
end)

--------------------------------------------------------------------------------
-- RECHERCHE DU MEILLEUR COIN
--------------------------------------------------------------------------------
local function chercherMeilleurCoin()
    logiqueCoinProche = nil
    local distMin = math.huge

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if string.lower(obj.Name) == "coin_server" and not coinsBlacklist[obj] and obj:IsDescendantOf(Workspace) then
            local targetPart = getCoinPart(obj)
            if targetPart and rootPart then
                local dist = (rootPart.Position - targetPart.Position).Magnitude
                if dist < distMin then
                    distMin = dist
                    logiqueCoinProche = {Object = obj, Part = targetPart}
                end
            end
        end
    end
    return logiqueCoinProche
end

task.spawn(function()
    while task.wait(0.05) do
        if isAutoFarmActive then
            currentTarget = chercherMeilleurCoin()
        end
    end
end)

--------------------------------------------------------------------------------
-- AUTOFARM LERP ULTRA-STABLE (-4 STUDS ➔ TP 0 STUD)
--------------------------------------------------------------------------------
RunService.Heartbeat:Connect(function(dt)
    if not isAutoFarmActive or not character or not rootPart or not humanoid then return end

    if currentTarget and currentTarget.Part and currentTarget.Part.Parent then
        humanoid.PlatformStand = true

        local coinPos = currentTarget.Part.Position
        local currentPos = rootPart.Position

        local targetBelowPos = Vector3.new(coinPos.X, coinPos.Y - 4, coinPos.Z)
        local distanceVector = targetBelowPos - currentPos
        local dist2D = distanceVector.Magnitude

        if dist2D <= 1.5 then
            rootPart.CFrame = CFrame.new(coinPos)
            blacklisterCoin(currentTarget.Object)
            rootPart.AssemblyLinearVelocity = Vector3.zero
        else
            local stepDistance = flySpeed * dt
            local alpha = math.min(stepDistance / dist2D, 1)

            rootPart.CFrame = rootPart.CFrame:Lerp(CFrame.new(targetBelowPos), alpha)
            rootPart.AssemblyLinearVelocity = Vector3.zero
        end
    else
        humanoid.PlatformStand = false
        rootPart.AssemblyLinearVelocity = Vector3.zero
    end
end)
