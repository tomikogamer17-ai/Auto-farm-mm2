local function blacklisterCoin(coinObj)
    if coinObj and not coinsBlacklist[coinObj] then
        coinsBlacklist[coinObj] = true
        if currentTarget and currentTarget.Object == coinObj then
            currentTarget = nil
        end
    end
end

Workspace.DescendantRemoving:Connect(function(obj)
    if string.lower(obj.Name) == "coin_server" then
        coinsBlacklist[obj] = true
    end
end)

--------------------------------------------------------------------------------
-- RECHERCHE DU MEILLEUR COIN
--------------------------------------------------------------------------------
local function chercherMeilleurCoin()
    local coinProche = nil
    local distMin = math.huge

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if string.lower(obj.Name) == "coin_server" and not coinsBlacklist[obj] and obj:IsDescendantOf(Workspace) then
            local targetPart = getCoinPart(obj)
            if targetPart and rootPart then
                local dist = (rootPart.Position - targetPart.Position).Magnitude
                if dist < distMin then
                    distMin = dist
                    coinProche = {Object = obj, Part = targetPart}
                end
            end
        end
    end
    return coinProche
end

task.spawn(function()
    while task.wait(0.05) do
        if isAutoFarmActive then
            currentTarget = chercherMeilleurCoin()
        end
    end
end)

--------------------------------------------------------------------------------
-- AUTOFARM A VITESSE 21 & ANCRAGE SOLIDE (PLATEFORME VIRTUELLE SANS CHUTE)
--------------------------------------------------------------------------------
RunService.Heartbeat:Connect(function(dt)
    if not isAutoFarmActive or isCollecting or not character or not rootPart or not humanoid then return end

    if currentTarget and currentTarget.Part and currentTarget.Part.Parent then
        humanoid.PlatformStand = true

        local coinPos = currentTarget.Part.Position
        local currentPos = rootPart.Position

        local targetBelowPos = Vector3.new(coinPos.X, coinPos.Y - 4, coinPos.Z)
        local distanceVector = targetBelowPos - currentPos
        local dist2D = distanceVector.Magnitude

        if dist2D <= 1.5 then
            isCollecting = true
            
            rootPart.CFrame = CFrame.new(coinPos)
            rootPart.AssemblyLinearVelocity = Vector3.zero
            
            task.wait(0.05)
            
            blacklisterCoin(currentTarget.Object)

            if rootPart then
                rootPart.CFrame = CFrame.new(targetBelowPos)
                rootPart.AssemblyLinearVelocity = Vector3.zero
            end
            
            isCollecting = false
        else
            local stepDistance = flySpeed * dt
            local alpha = math.min(stepDistance / dist2D, 1)

            rootPart.CFrame = rootPart.CFrame:Lerp(CFrame.new(targetBelowPos), alpha)
            rootPart.AssemblyLinearVelocity = Vector3.zero
        end
    else
        -- Ancrage total sur place : maintient à -4 studs exacts sans aucune gravité
        humanoid.PlatformStand = true
        rootPart.AssemblyLinearVelocity = Vector3.zero
        rootPart.RotVelocity = Vector3.zero
    end
end)
